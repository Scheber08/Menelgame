{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menelgame",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // Statische Web-App; /api/* und die WebSockets unter /r/<code>/ws laufen über den Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*/ws"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }],
  },
  // Profile, eigene Packs und Regelsets. Für das Deployment einmal anlegen:
  //   pnpm --filter @menelgame/server exec wrangler d1 create menelgame
  // und die ausgegebene database_id hier eintragen. Lokal reicht der Platzhalter.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menelgame",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Free Plan: nur SQLite-gestützte Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true },
}
