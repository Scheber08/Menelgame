{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menelgame",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // Statische Web-App; /api/* und die WebSockets unter /r/<code>/ws laufen über den Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*/ws", "/img/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }],
  },
  // Profile, eigene Packs und Regelsets. Ohne database_id legt `wrangler deploy` die
  // Datenbank beim ersten Deployment selbst an und findet sie danach über den Namen.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "menelgame",
      "migrations_dir": "migrations",
    },
  ],
  // Hochgeladene Bilder für Packs; der Bucket wird beim ersten Deployment angelegt.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "menelgame-images" }],
  // Free Plan: nur SQLite-gestützte Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true },
}
